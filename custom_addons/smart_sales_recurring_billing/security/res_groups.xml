<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category -->
        <record id="module_category_subscription" model="ir.module.category">
            <field name="name">Recurring Subscriptions</field>
            <field name="description">Manage recurring contracts, subscription billing, and quotation automation.</field>
            <field name="sequence">25</field>
        </record>

        <!-- Standard Subscription User -->
        <record id="group_subscription_user" model="res.groups">
            <field name="name">User / Sales Rep</field>
            <field name="category_id" ref="module_category_subscription"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <!-- Subscription Administrator / Manager -->
        <record id="group_subscription_manager" model="res.groups">
            <field name="name">Administrator / Manager</field>
            <field name="category_id" ref="module_category_subscription"/>
            <field name="implied_ids" eval="[(4, ref('group_subscription_user')), (4, ref('sales_team.group_sale_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
