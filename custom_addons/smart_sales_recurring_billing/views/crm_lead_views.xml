<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crm_lead_view_form_inherit_recurring" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit.recurring</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <!-- Action button to generate recurring quotation -->
                <xpath expr="//header" position="inside">
                    <button name="action_create_recurring_quotation"
                            string="New Recurring Quote"
                            type="object"
                            class="btn-primary"
                            invisible="type == 'lead'"/>
                </xpath>

                <!-- Subscription & MRR Metrics Block -->
                <xpath expr="//group[@name='lead_priority']" position="after">
                    <group name="subscription_revenue_group" string="Recurring Revenue Pipeline">
                        <field name="is_subscription_lead" widget="boolean_toggle"/>
                        <field name="recurring_billing_cycle" invisible="not is_subscription_lead"/>
                        <field name="expected_mrr" widget="monetary" options="{'currency_field': 'company_currency'}" invisible="not is_subscription_lead"/>
                        <field name="expected_arr" widget="monetary" options="{'currency_field': 'company_currency'}" invisible="not is_subscription_lead"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
