<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sale Order Form View Extension -->
        <record id="view_order_form_inherit_recurring" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.recurring</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Header Approval Button -->
                <xpath expr="//header" position="inside">
                    <button name="action_approve_high_discount"
                            type="object"
                            string="Approve High Discount"
                            class="btn-warning"
                            invisible="not require_discount_approval or discount_approved"
                            groups="sales_team.group_sale_manager"/>
                </xpath>

                <!-- Smart Button to view generated Subscription -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_subscription"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-repeat"
                            invisible="not subscription_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Subscription</span>
                            <span class="o_stat_text">Contract</span>
                        </div>
                    </button>
                </xpath>

                <!-- Discount Warning Alert -->
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-warning mb-0" role="alert" invisible="not require_discount_approval or discount_approved">
                        <strong>⚠️ Manager Approval Required:</strong> One or more lines exceed the 20% discount threshold. A Sales Manager must approve before confirmation.
                    </div>
                </xpath>

                <!-- Pricing & Subscription Configuration -->
                <xpath expr="//group[@name='order_details']" position="after">
                    <group name="smart_pricing_group" string="Quotation Builder &amp; Subscription Setup">
                        <field name="pricing_tier" widget="radio" options="{'horizontal': true}"/>
                        <field name="total_cost_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="profit_margin_pct" widget="badge" decoration-success="profit_margin_pct &gt;= 30.0" decoration-warning="profit_margin_pct &gt;= 15.0 and profit_margin_pct &lt; 30.0" decoration-danger="profit_margin_pct &lt; 15.0"/>
                        <field name="require_discount_approval" invisible="1"/>
                        <field name="discount_approved" readonly="1" invisible="not require_discount_approval"/>
                        <field name="is_subscription"/>
                        <field name="billing_cycle" invisible="not is_subscription" required="is_subscription"/>
                        <field name="subscription_id" invisible="not subscription_id"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Sale Order Tree View Extension -->
        <record id="view_quotation_tree_inherit_recurring" model="ir.ui.view">
            <field name="name">sale.order.tree.inherit.recurring</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_total']" position="after">
                    <field name="profit_margin_pct" optional="show" widget="badge" decoration-success="profit_margin_pct &gt;= 30.0" decoration-warning="profit_margin_pct &gt;= 15.0 and profit_margin_pct &lt; 30.0" decoration-danger="profit_margin_pct &lt; 15.0"/>
                    <field name="is_subscription" optional="show" widget="boolean_toggle"/>
                    <field name="billing_cycle" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
