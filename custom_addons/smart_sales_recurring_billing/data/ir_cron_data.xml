<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily automated invoice generation cron -->
        <record id="ir_cron_auto_generate_recurring_invoices" model="ir.cron">
            <field name="name">Subscriptions: Automated Invoice Generator</field>
            <field name="model_id" ref="model_recurring_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_recurring_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
